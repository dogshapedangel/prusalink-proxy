<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PS:One 3D Printers</title>
  <style>
    body {
      background-color: #fae6e6;
      text-align: center;
      font-family: 'Courier New', Courier, monospace;
    }
    ul {
      list-style: none;
      padding: 0;
    }
    li {
      margin: 6px 0;
      font-size: 2.2em;
    }
    p {
      font-size: 1.5em;
    }
  </style>
</head>
<body>
  <h1>PS:One 3D Printer Dashboard</h1>
  <p>Select a printer:</p>
  <ul>
    <li><a href="https://pink.psone.space"><span style="color: black; background: pink; padding: 2px 4px; border-radius: 4px;">pink.psone.space (Core One+)</span></a></li>
    <li><a href="https://blue.psone.space"><span style="color: black; background: lightblue; padding: 2px 4px; border-radius: 4px;">blue.psone.space (Core One+)</span></a></li>
    <li><a href="https://white.psone.space"><span style="color: black; background: white; padding: 2px 4px; border-radius: 4px;">white.psone.space (Core One+)</span></a></li>
  </ul>
    <ul>
    <li><a href="https://purple.psone.space"><span style="color: rgb(245, 111, 245); background: black; padding: 2px 4px; border-radius: 4px;">purple.psone.space (Core One+ L)</span></a></li>
    <li><a href="https://orange.psone.space"><span style="color: orange; background: black; padding: 2px 4px; border-radius: 4px;">orange.psone.space (Core One+ L)</span></a></li>
  </ul>
</body>
</html>
