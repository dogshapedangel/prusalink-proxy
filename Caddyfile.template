# Caddy configuration for PrusaLink with Azure AD B2C OIDC
# Automatic certs use the Cloudflare DNS challenge.
# THIS FILE IS AUTO-GENERATED - See Caddyfile.template and init.sh

{{SITE_ADDRESSES}} {
  # Public landing page with links to individual printer hosts and live status.
  # Camera pages are auth-gated, so exclude the proxied go2rtc subtree.
  @printers_index {
    host printers.psone.space
    not path /camera/*
    not path /oauth2/*
  }
  handle @printers_index {
    reverse_proxy printers-status:8888
  }

  # OAuth2 authentication via Azure AD B2C
  route {
    # Expose oauth2-proxy's own endpoints (sign in, callback, logout)
    handle /oauth2/* {
      reverse_proxy oauth2-proxy:4180
    }

    # Optional: when camera OAuth is disabled, camera routes are injected here
    # so they bypass the OAuth and AD authorization checks below.
{{CAMERA_ROUTES_PREAUTH}}

    # Send first-time browser requests straight into the OIDC flow instead of
    # showing oauth2-proxy's intermediary sign-in page.
    @no_session {
      not header_regexp Cookie (^|;\s*)_oauth2_proxy=
    }
    redir @no_session /oauth2/start?rd={uri} 302

    # Verify existing sessions with oauth2-proxy
    forward_auth oauth2-proxy:4180 {
      uri /oauth2/auth
      copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups X-Forwarded-User X-Forwarded-Email
    }

    # Authorize users against on-prem AD group membership.
    # authz-ad returns 200 to allow, 403 to deny.
    forward_auth authz-ad:8081 {
      uri /authz
      copy_headers X-Authz-Decision X-Authz-Reason
    }

    # Optional: when camera OAuth is enabled, camera routes are injected here
    # so they require OAuth and AD authorization before proxying to go2rtc.
{{CAMERA_ROUTES_POSTAUTH}}

    # Route all authenticated traffic through the digest bridge so PrusaLink's UI
    # API does not trigger the browser credential prompt.
    handle {
      reverse_proxy prusalink-digest-proxy:8080 {
        header_up X-Real-IP {http.request.remote.host}
        header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_down -Www-Authenticate
      }
    }
  }

  # Logs
  log {
    output stdout
    format json
  }
}

# Redirect HTTP to HTTPS
http:// {
  redir https://{host}{uri} permanent
}
