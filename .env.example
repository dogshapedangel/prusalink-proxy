# Environment Configuration for PrusaLink OAuth2 Proxy
# Copy this to .env and fill in your values.
# Multi-printer setups use PRINTER_IDS plus one PRINTER_<ID>_* block per printer.

# ============================================
# Domain / TLS Configuration
# ============================================
# Email used for ACME / Let's Encrypt registration
ACME_EMAIL=admin@example.com

# Cloudflare API token for DNS challenge certificate provisioning
# Required permissions: Zone.Zone:Read and Zone.DNS:Edit
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token

# ============================================
# Printer Configuration
# ============================================
# Comma- or space-separated printer IDs. IDs are converted to uppercase and
# non-alphanumeric characters become underscores when resolving env vars.
PRINTER_IDS=mk4,xl

# Printer 1
PRINTER_MK4_DOMAIN=mk4.example.com
PRINTER_MK4_URL=http://mk4.local/
PRINTER_MK4_USERNAME=your_mk4_prusalink_username
PRINTER_MK4_PASSWORD=your_mk4_prusalink_password

# Printer 2
PRINTER_XL_DOMAIN=xl.example.com
PRINTER_XL_URL=http://xl.local/
PRINTER_XL_USERNAME=your_xl_prusalink_username
PRINTER_XL_PASSWORD=your_xl_prusalink_password

# Printer status dashboard camera feed buttons.
STATUS_APP_CAMERA_FEEDS_ENABLED=false

# Auto-refresh interval for the printer status dashboard in seconds. Set to 0 to disable.
STATUS_APP_REFRESH_INTERVAL=120

# Require OAuth login for camera feed endpoints served via /camera/*.
# Set to false to allow direct camera viewing without oauth2-proxy.
CAMERA_FEEDS_REQUIRE_OAUTH=true

# TURN server settings for WebRTC ICE relay fallback.
TURN_REALM=turn.example.com
TURN_USERNAME=replace_with_turn_username
TURN_PASSWORD=replace_with_turn_password
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Legacy single-printer fallback still works if PRINTER_IDS is omitted.
# DOMAIN=printers.example.com
# PRUSALINK_URL=http://printer.local/
# PRUSALINK_USERNAME=your_prusalink_username
# PRUSALINK_PASSWORD=your_prusalink_password

# ============================================
# OIDC Configuration
# ============================================
# Create an OAuth2/OpenID Provider (client type: Confidential)
# and an Application bound to it. On the provider:
#   - Redirect URIs: https://<each printer domain>/oauth2/callback
#     (or one regex entry, e.g. https://.*\.example\.com/oauth2/callback)
#   - Signing Key: select a certificate (required for RS256/JWKS validation)
#   - Scopes: openid, email, profile, offline_access
#
# Issuer URL is https://<host>/application/o/<application-slug>/
# The trailing slash is required; it must match the token "iss" claim exactly.
OIDC_ISSUER_URL=https://auth.example.com/application/o/prusalink/

# Client ID / Secret from the Authentik provider
OIDC_CLIENT_ID=your_authentik_client_id
OIDC_CLIENT_SECRET=your_authentik_client_secret

# Claims used for the user's email and group membership.
OIDC_EMAIL_CLAIM=email
OIDC_GROUPS_CLAIM=groups

# Optional: restrict login to members of these groups (comma-separated names as
# they appear in the groups claim). Leave empty to allow any authenticated user.
# OIDC_ALLOWED_GROUPS=prusalink-users

# Some Authentik versions emit email_verified=false by default, which oauth2-proxy
# rejects. Set to true if login fails with "email not verified".
OIDC_ALLOW_UNVERIFIED_EMAIL=false

# offline_access yields a refresh token so sessions refresh every 24h.
OAUTH2_PROXY_SCOPE=openid profile email offline_access

# Optional overrides.
# Usually leave OAUTH2_PROXY_REDIRECT_URL unset so oauth2-proxy derives
# https://<current-host>/oauth2/callback automatically from the request headers.
# If you need to force it, use a full absolute URL that is registered in Authentik.
# OAUTH2_PROXY_REDIRECT_URL=https://mk4.example.com/oauth2/callback
# OAUTH2_PROXY_WHITELIST_DOMAINS=.example.com,.example.org
# OAUTH2_PROXY_COOKIE_SECURE=false

# ============================================
# oauth2-proxy Session Configuration
# ============================================
# Generate with: openssl rand -base64 32
# Used for encrypting session cookies
COOKIE_SECRET=replace_with_openssl_rand_base64_32_output
