# Environment Configuration for PrusaLink OAuth2 Proxy
# Copy this to .env and fill in your values.
# Multi-printer setups use PRINTER_IDS plus one PRINTER_<ID>_* block per printer.

# ============================================
# Domain / TLS Configuration
# ============================================
# Email used for ACME / Let's Encrypt registration
ACME_EMAIL=admin@example.com

# Cloudflare API token for DNS challenge certificate provisioning
# Required permissions: Zone.Zone:Read and Zone.DNS:Edit
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token

# ============================================
# Printer Configuration
# ============================================
# Comma- or space-separated printer IDs. IDs are converted to uppercase and
# non-alphanumeric characters become underscores when resolving env vars.
PRINTER_IDS=mk4,xl

# Printer 1
PRINTER_MK4_DOMAIN=mk4.example.com
PRINTER_MK4_URL=http://mk4.local/
PRINTER_MK4_USERNAME=your_mk4_prusalink_username
PRINTER_MK4_PASSWORD=your_mk4_prusalink_password

# Printer 2
PRINTER_XL_DOMAIN=xl.example.com
PRINTER_XL_URL=http://xl.local/
PRINTER_XL_USERNAME=your_xl_prusalink_username
PRINTER_XL_PASSWORD=your_xl_prusalink_password

# Printer status dashboard camera feed buttons.
STATUS_APP_CAMERA_FEEDS_ENABLED=false

# Require OAuth/AD authorization for camera feed endpoints served via /camera/*.
# Set to false to allow direct camera viewing without oauth2-proxy/authz-ad.
CAMERA_FEEDS_REQUIRE_OAUTH=true

# TURN server settings for WebRTC ICE relay fallback.
# Internal-only use is fine; the TURN host only needs to be reachable on the
# private network where browsers access the printer dashboard.
TURN_REALM=turn.example.com
TURN_USERNAME=replace_with_turn_username
TURN_PASSWORD=replace_with_turn_password
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Legacy single-printer fallback still works if PRINTER_IDS is omitted.
# DOMAIN=printers.example.com
# PRUSALINK_URL=http://printer.local/
# PRUSALINK_USERNAME=your_prusalink_username
# PRUSALINK_PASSWORD=your_prusalink_password

# ============================================
# Azure AD B2C Configuration
# ============================================
# Open your user flow metadata document, for example:
# https://your-tenant.b2clogin.com/your-tenant.onmicrosoft.com/B2C_1_signupsignin/v2.0/.well-known/openid-configuration
# Then copy the JSON "issuer" value into this variable.
AZURE_B2C_OIDC_ISSUER_URL=https://your-tenant.b2clogin.com/your-tenant-guid/v2.0/

# OAuth application Client ID (from the Azure AD B2C app registration)
AZURE_B2C_CLIENT_ID=your_azure_b2c_client_id

# OAuth application Client Secret (from the Azure AD B2C app registration)
AZURE_B2C_CLIENT_SECRET=your_azure_b2c_client_secret

# Claim that contains the user's email address.
# Keep this as "email" if your user flow emits an email claim.
AZURE_B2C_EMAIL_CLAIM=email

# Azure AD B2C must issue an access token for oauth2-proxy during the callback.
# Include the app's own client ID as a scope so the token response contains access_token.
OAUTH2_PROXY_SCOPE=openid profile email offline_access your_azure_b2c_client_id

# Optional overrides.
# Usually leave OAUTH2_PROXY_REDIRECT_URL unset so oauth2-proxy derives
# https://<current-host>/oauth2/callback automatically from the request headers.
# If you need to force it, use a full absolute URL that is registered in Azure B2C.
# OAUTH2_PROXY_REDIRECT_URL=https://mk4.example.com/oauth2/callback
# OAUTH2_PROXY_WHITELIST_DOMAINS=.example.com,.example.org
# OAUTH2_PROXY_COOKIE_SECURE=false

# ============================================
# oauth2-proxy Session Configuration
# ============================================
# Generate with: openssl rand -base64 32
# Used for encrypting session cookies
COOKIE_SECRET=replace_with_openssl_rand_base64_32_output

# ============================================
# Optional: On-Prem AD Authorization Service
# ============================================
# Enforces that authenticated users are members of a required AD security group.
# If AUTHZ_AD_ENFORCE=false, decisions are logged but requests are still allowed.
AUTHZ_AD_ENFORCE=true

# Header names sent by oauth2-proxy via Caddy forward_auth.
AUTHZ_AD_HEADER_EMAIL=X-Auth-Request-Email
AUTHZ_AD_HEADER_USER=X-Auth-Request-User

# Authorization decision cache (seconds).
AUTHZ_AD_CACHE_TTL_SECONDS=300
AUTHZ_AD_NEGATIVE_CACHE_TTL_SECONDS=60

# On-prem AD / LDAP connection settings.
# Prefer LDAPS on 636 and validate certificates.
AUTHZ_AD_LDAP_URI=ldaps://dc01.corp.local:636
AUTHZ_AD_BIND_DN=CN=svc-prusalink-authz,OU=Service Accounts,DC=corp,DC=local
AUTHZ_AD_BIND_PASSWORD=replace_with_service_account_password
AUTHZ_AD_BASE_DN=DC=corp,DC=local
AUTHZ_AD_ALLOWED_GROUP_DN=CN=PrusaLink-Users,OU=Security Groups,DC=corp,DC=local

# Identity attributes to search in AD for the principal from oauth2-proxy headers.
AUTHZ_AD_IDENTITY_ATTRS=mail,userPrincipalName,sAMAccountName

# LDAP client behavior.
AUTHZ_AD_CONNECT_TIMEOUT_SECONDS=2
AUTHZ_AD_READ_TIMEOUT_SECONDS=2
AUTHZ_AD_TLS_VALIDATE=true
# AUTHZ_AD_TLS_CA_CERT_FILE=/run/secrets/ad-ca.crt
AUTHZ_AD_LOG_LEVEL=INFO
